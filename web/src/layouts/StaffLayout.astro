---
import { StaffSidebar } from "../components/layout/StaffSidebar";
import { ToastContainer } from "../components/custom/Toast";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/logo.png" />
    <title>{title}</title>
    <ClientRouter />

    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("Suavus_user");
          if (stored) window.__AUTH_USER__ = JSON.parse(stored);
        } catch {}
      })();
      (function () {
        function applyTheme() {
          try {
            const storedTheme = localStorage.getItem("theme");
            const systemTheme = window.matchMedia(
              "(prefers-color-scheme: dark)",
            ).matches;
            if (
              storedTheme === "dark" ||
              (!storedTheme && systemTheme) ||
              (storedTheme === "system" && systemTheme)
            ) {
              document.documentElement.classList.add("dark");
            } else {
              document.documentElement.classList.remove("dark");
            }
          } catch (e) {
            console.error(e);
          }
        }
        applyTheme();
        document.addEventListener("astro:after-swap", applyTheme);
        document.addEventListener("astro:page-load", applyTheme);
      })();
    </script>
  </head>

  <body
    class="bg-background flex text-foreground antialiased h-screen overflow-hidden"
  >
    <StaffSidebar client:only="react" currentPath={currentPath} />

    <main class="flex-1 lg:ml-0 overflow-y-auto">
      <div class="p-4 lg:p-8 pt-16 lg:pt-8 min-h-full">
        <slot />
      </div>
    </main>

    <ToastContainer client:load />
  </body>
</html>
