---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { RestaurantDetail } from "../../../../components/admin/RestaurantDetalles";

export const prerender = false;

// Obtenemos el ID de la URL
const { id } = Astro.params;

// Si no hay ID, podríamos redirigir o mostrar error
if (!id) {
  return Astro.redirect("/admin/restaurants");
}
---

<AdminLayout title={`Restaurante ${id} - Admin`}>
  <RestaurantDetail id={id} client:load />
</AdminLayout>
