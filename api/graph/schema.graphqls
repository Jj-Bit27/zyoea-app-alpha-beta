# graph/schema.graphqls

scalar Time
scalar Int64

# --- Users (Usuarios) ---
type User {
  id: ID!
  name: String
  email: String
  role: String
  isVerified: Boolean!
  allergies: String
}

type UserWithRestaurant {
  id: ID!
  name: String
  email: String
  role: String
  isVerified: Boolean!
  restaurant: Int
}

type AuthResponse {
  accessToken: String!
  user: User!
  restaurant: Int
}

input RegisterInput {
  name: String!
  email: String!
  password: String!
  role: String!
}

input LoginInput {
  email: String!
  password: String!
  restaurant: Int
}

# --- Restaurants (Restaurantes) ---
type Restaurant {
  id: ID!
  name: String!
  address: String!
  email: String!
  description: String!
  image: String
  phone: String!
  hours: String!
}

input CreateRestaurantInput {
  name: String!
  address: String!
  email: String!
  description: String!
  image: String
  phone: String!
  hours: String!
}

input UpdateRestaurantInput {
  id: ID!
  name: String
  address: String
  email: String
  description: String
  image: String
  phone: String
  hours: String
}

# --- Payments (Pagos) ---
type Payment {
  id: ID!
  userId: String!
  user: User!
  stripePaymentIntentId: String!
  stripePaymentMethodId: String
  amount: Float!
  currency: String!
  status: String!
  description: String
  stripeApplicationFeeAmount: Float
  paymentMethodType: String
  createdAt: String!
  updatedAt: String!
  orderId: Int
}

input CreatePaymentInput {
  userId: String!
  amount: Float!
  currency: String!
  paymentMethodId: String!
  description: String
  orderId: Int
}

input RefundPaymentInput {
  payment: ID!
  amount: Float
}

# --- Products (Productos) ---
type Product {
  id: ID!
  restaurantId: Int!
  restaurant: Restaurant!
  categoryId: Int!
  category: Category!
  name: String!
  description: String
  ingredients: String
  allergens: String
  price: Float!
  status: Boolean!
  image: String
}

input CreateProductInput {
  restaurant: Int!
  category: Int!
  name: String!
  description: String
  ingredients: String
  allergens: String
  price: Float!
  status: Boolean!
  image: String
}

input UpdateProductInput {
  id: ID!
  restaurant: Int
  category: Int
  name: String
  description: String
  ingredients: String
  allergens: String
  price: Float
  status: Boolean
  image: String
}

# --- Bookings (Reservas) ---
type Booking {
  id: ID!
  restaurantId: Int!
  restaurant: Restaurant!
  userId: Int!
  user: User!
  tableId: Int!
  people: Int!
  time: Time!
  status: String!
  cancellationReason: String
}

input CreateBookingInput {
  restaurant: Int!
  user: Int!
  table: Int!
  people: Int!
  time: Time!
  status: String!
}

input UpdateBookingInput {
  id: ID!
  restaurant: Int
  user: Int
  table: Int
  people: Int
  time: Time
  status: String
  cancellationReason: String
}

# --- Reviews (Comentarios) ---
type Review {
  id: ID!
  restaurantId: Int!
  restaurant: Restaurant!
  userId: Int!
  user: User!
  rating: Int!
  comment: String!
  date: Time!
}

input CreateReviewInput {
  restaurant: Int!
  user: Int!
  rating: Int!
  comment: String!
}

input UpdateReviewInput {
  id: ID!
  restaurant: Int
  user: Int
  rating: Int
  comment: String
}

# --- Tables (Mesas) ---
type Table {
  id: ID!
  restaurantId: Int!
  restaurant: Restaurant!
  bookingId: Int
  booking: Booking
  number: Int!
  capacity: Int!
  status: String!
}

input CreateTableInput {
  restaurant: Int!
  number: Int!
  capacity: Int!
  status: String!
}

input UpdateTableInput {
  id: ID!
  restaurant: Int
  number: Int
  bookingId: Int
  capacity: Int
  status: String
}

# --- Categories (Categorias) ---
type Category {
  id: ID!
  restaurantId: Int!
  restaurant: Restaurant!
  name: String!
}

input CreateCategoryInput {
  restaurant: Int!
  name: String!
}

input UpdateCategoryInput {
  id: ID!
  restaurant: Int
  name: String
}

# --- Employees (Empleados) ---
type Employee {
  id: ID!
  restaurantId: Int!
  restaurant: Restaurant!
  position: String!
  hireDate: Time
  userId: Int!
  user: User!
}

input CreateEmployeeInput {
  name: String!
  email: String!
  password: String! # Obligatorio al crear
  role: String! # Obligatorio al crear
  restaurantId: Int!
  position: String!
}

input UpdateEmployeeInput {
  id: ID!
  name: String
  email: String
  restaurantId: Int
  position: String
}

# --- Orders Ordenes) ---
type Order {
  id: ID!
  userId: Int!
  user: User!
  user_name: String!
  restaurantId: Int!
  restaurant: Restaurant!
  status: String!
  type: String!
  total: Float!
  notes: String
  tableId: Int
  date: Time!
  paid: Boolean!
  orderDetail: [OrderDetail!]
  estimatedWaitTime: Int!  # Tiempo estimado en minutos
  actualWaitTime: Int      # Tiempo real en minutos (null si no completado)
  completedAt: Time        # Cuándo se completó la orden
}

type OrderDetail {
  id: ID!
  order: Int!
  productId: Int!
  product: Product!
  quantity: Int!
  subtotal: Float!
}

input OrderItemInput {
  productId: Int!
  quantity: Int!
  subtotal: Float!
}

input CreateOrderInput {
  user: Int!
  user_name: String!
  restaurant: Int!
  status: String!
  type: String!
  total: Float!
  notes: String
  table: Int
  paid: Boolean
  items: [OrderItemInput!]!
}

input UpdateOrderInput {
  id: ID!
  estado: String # Según tu código NestJS, solo actualizas estado
}

# --- QUERIES (Lectura) ---
type Query {
  # --- Users (Usuarios) ---
  verifyToken(token: String): UserWithRestaurant
  user(id: ID!): User!

  # -- Restaurants (Restaurantes) --
  restaurants: [Restaurant!]!
  restaurant(id: ID!): Restaurant!

  # --- Payments (Pagos) ---
  payment(id: ID!): Payment
  payments(limit: Int, offset: Int): [Payment!]!
  userPayments(userId: String!): [Payment!]!

  # -- Bookings (Reservas) --
  bookings(restaurantId: ID!): [Booking!]!
  bookingsUser(userId: ID!): [Booking!]!
  booking(id: ID!): Booking!

  # -- Products (Productos) --
  products(restaurantId: ID!): [Product!]!
  product(id: ID!): Product!

  # -- Reviews (Reseñas) --
  reviews(restaurantId: ID!): [Review!]!
  review(id: ID!): Review!

  # --- Tables (Mesas) ---
  tables(restaurantId: ID!): [Table!]!
  table(id: ID!): Table!

  # --- Categories (Categorias) ---
  categories(restaurantId: ID!): [Category!]!
  category(id: ID!): Category!

  # --- Employees (Empleados) ---
  employeesByRestaurant(restaurantId: ID!): [Employee!]!
  employee(id: ID!): Employee!

   # --- Orders (Ordenes) ---
  ordersByRestaurant(restaurantId: ID!): [Order!]!
  ordersOpen(restaurantId: ID!): [Order!]!
  ordersByUser(userId: ID!): [Order!]!
  order(id: ID!): Order!

   # --- Wait Times (Tiempos de Espera) ---
  estimatedWaitTime(restaurantId: ID!): Int!
  restaurantWaitMetrics(restaurantId: ID!): RestaurantMetrics!
  recentOrderMetrics(restaurantId: ID!, limit: Int): [PreparedOrderMetric!]!

  # --- Restaurant Payment Methods (Métodos de Pago) ---
  getRestaurantPaymentMethod(userId: ID!): RestaurantPaymentMethod
  getRestaurantPaymentMethodStatus(userId: ID!): RestaurantPaymentMethod

  # --- Cart (Carrito) ---
  getCart(userId: ID!): [CartItem!]!

  # --- Terms & Privacy ---
  getTermsContent(type: TermsType!): TermsContent!
  getCurrentTermsAcceptance(type: TermsType!): TermsAcceptance
  checkPendingTermsAcceptance: [TermsType!]!

  # --- Cloudinary ---
  getCloudinarySignature(publicId: String!, timestamp: Int!): CloudinarySignature!
}

# --- MUTATIONS (Escritura) ---
type Mutation {
  # --- Users (Usuarios) ---
  register(input: RegisterInput!): AuthResponse!
  login(input: LoginInput!): AuthResponse!
  verifyEmail(code: String!): User!
  forgotPassword(email: String!): Boolean!
  resetPassword(token: String!, password: String!): Boolean!
  updateUser(id: ID!, name: String, email: String): User!
  updateUserAllergies(id: ID!, allergies: String!): User!
  deleteAccount(id: ID!): Boolean!

  # -- Restaurants (Restaurantes) --
  createRestaurant(input: CreateRestaurantInput!): Restaurant!
  updateRestaurant(id: ID!, input: UpdateRestaurantInput!): Restaurant!
  deleteRestaurant(id: ID!): Boolean!

  # --- Payments (Pagos) ---
  createPayment(input: CreatePaymentInput!): Payment!
  refundPayment(input: RefundPaymentInput!): Payment!

  # -- Bookings (Reservas) --
  createBooking(input: CreateBookingInput!): Booking!
  updateBooking(id: ID!, input: UpdateBookingInput!): Booking!
  deleteBooking(id: ID!): Boolean!

  # -- Products (Productos) --
  createProduct(input: CreateProductInput!): Product!
  updateProduct(id: ID!, input: UpdateProductInput!): Product!
  deleteProduct(id: ID!): Boolean!

  # -- Reviews (Reseñas) --
  createReview(input: CreateReviewInput!): Review!
  updateReview(id: ID!, input: UpdateReviewInput!): Review!
  deleteReview(id: ID!): Boolean!

  # --- Tables (Mesas) ---
  createTable(input: CreateTableInput!): Table!
  updateTable(id: ID!, input: UpdateTableInput!): Table!
  deleteTable(id: ID!): Boolean!

  # --- Categories (Categorias) ---
  createCategory(input: CreateCategoryInput!): Category!
  updateCategory(id: ID!, input: UpdateCategoryInput!): Category!
  deleteCategory(id: ID!): Boolean!

  # --- Employees (Empleados) ---
  createEmployee(input: CreateEmployeeInput!): Employee!
  updateEmployee(input: UpdateEmployeeInput!): Employee!
  removeEmployee(id: ID!): Boolean!

    # --- Orders (Ordenes) ---
  createOrder(input: CreateOrderInput!, idempotencyKey: String!): Order!
  updateOrderStatus(id: ID!, status: String!): Order!
  updateOrderPayment(id: ID!, paid: Boolean!): Order!
  addOrderItems(orderId: ID!, items: [OrderItemInput!]!): Order!
  removeOrderItem(orderId: ID!, itemId: ID!): Order!
  removeOrder(id: ID!): Boolean!

  # --- Restaurant Payment Methods ---
  createRestaurantPaymentMethod(userId: ID!, input: CreateRestaurantPaymentMethodInput!): RestaurantPaymentMethod!
  updateRestaurantPaymentMethod(userId: ID!, input: CreateRestaurantPaymentMethodInput!): RestaurantPaymentMethod!

  # --- Cart ---
  addToCart(userId: ID!, productId: Int!, quantity: Int!, restaurantId: Int!): CartItem!
  updateCartItem(userId: ID!, productId: Int!, quantity: Int!): CartItem!
  removeFromCart(userId: ID!, productId: Int!): Boolean!
  clearCart(userId: ID!): Boolean!

  # --- Terms & Privacy ---
  acceptTerms(userId: ID!, type: TermsType!): TermsAcceptance!
}

# --- Wait Time Types (Tipos de Tiempo de Espera) ---
type RestaurantMetrics {
  restaurantId: ID!
  totalOrders: Int!
  averagePrepTime: Int!
  medianPrepTime: Int!
  peakHourOrders: Int!
  nonPeakHourOrders: Int!
  mostCommonItemCount: Int!
}

type PreparedOrderMetric {
  orderId: ID!
  restaurantId: ID!
  itemCount: Int!
  preparedTimeMinutes: Int!
  createdAt: Time!
  completedAt: Time!
  wasPeakHour: Boolean!
}

# --- Restaurant Payment Methods (Métodos de Pago del Restaurante) ---
type RestaurantPaymentMethod {
  id: ID!
  restaurantId: ID!
  stripeConnectAccountId: String
  stripeOnboardingUrl: String
  stripeOnboardingCompleted: Boolean!
  accountHolderName: String!
  accountType: String!
  bankAccountLast4: String
  routingNumber: String
  countryCode: String!
  status: String!
  verificationRequiredAt: Time
  activatedAt: Time
  createdAt: Time!
  updatedAt: Time!
}

input CreateRestaurantPaymentMethodInput {
  accountHolderName: String!
  routingNumber: String!
  countryCode: String
}

# --- Cart Types (Tipos de Carrito) ---
type CartItem {
  id: ID!
  productId: ID!
  productName: String!
  productImage: String
  quantity: Int!
  price: Float!
  restaurantId: ID!
}

# --- Terms & Privacy Types ---
enum TermsType {
  USER_TERMS
  RESTAURANT_TERMS
  PRIVACY_POLICY
}

type TermsContent {
  type: TermsType!
  title: String!
  content: String!
  version: String!
  lastUpdated: Time!
}

type TermsAcceptance {
  id: ID!
  termsType: TermsType!
  acceptedAt: Time!
}

# --- Cloudinary Types ---
type CloudinarySignature {
  signature: String!
  timestamp: Int!
  apiKey: String!
  cloudName: String!
  publicId: String!
}

# --- Subscription System (Planes y Suscripciones) ---
type SubscriptionPlan {
  id: ID!
  name: String!
  description: String
  price: Float!
  interval: String!
  stripePriceId: String
  features: String
  maxRestaurants: Int!
  maxEmployees: Int!
  maxProducts: Int!
  createdAt: Time!
  updatedAt: Time!
}

type RestaurantSubscription {
  id: ID!
  restaurantId: Int!
  planId: Int!
  plan: SubscriptionPlan!
  stripeSubscriptionId: String
  status: String!
  currentPeriodStart: Time
  currentPeriodEnd: Time
  trialEnd: Time
  cancelledAt: Time
  createdAt: Time!
  updatedAt: Time!
}

input CreateSubscriptionInput {
  restaurantId: Int!
  planId: Int!
  stripeSubscriptionId: String
  currentPeriodStart: Time
  currentPeriodEnd: Time
}

extend type Query {
  subscriptionPlans: [SubscriptionPlan!]!
  restaurantSubscription(restaurantId: ID!): RestaurantSubscription
  allSubscriptions: [RestaurantSubscription!]!
}

extend type Mutation {
  createSubscription(input: CreateSubscriptionInput!): RestaurantSubscription!
  cancelSubscription(restaurantId: ID!): RestaurantSubscription!
}

# --- SuperAdmin ---
extend type Query {
  totalUsers: Int!
}

type Subscription {
  # El backend enviará una Order cada vez que ocurra este evento
  orderCreated(restaurantId: Int!): Order!
  orderStatusUpdated(restaurantId: Int!): Order!
}
